require 'json'

# Native Couchbase Lite SDK version is defined once in package.json (couchbaseLite.nativeVersion).
couchbase_lite_version = JSON.parse(File.read(File.join(__dir__, '..', 'package.json')))['couchbaseLite']['nativeVersion']

platform :ios, '15.0'

def capacitor_pods
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!
  pod 'Capacitor', :path => '../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../node_modules/@capacitor/ios'
end

def couchbase_pods(version)
  use_frameworks!
  pod 'CouchbaseLite-Swift-Enterprise', version
end

target 'Plugin' do
  couchbase_pods(couchbase_lite_version)
  capacitor_pods
end

target 'PluginTests' do
  couchbase_pods(couchbase_lite_version)
  capacitor_pods
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
